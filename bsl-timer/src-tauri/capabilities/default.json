{
  "identifier": "default",
  "description": "Capabilities for the main, settings, and About windows",
  "windows": ["main", "settings", "about"],
  "permissions": [
    "core:event:allow-emit-to",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-available-monitors",
    "core:window:allow-minimize",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://bsl-world.ru/" },
        { "url": "https://bsl-world.ru/soft/bsl-timer" },
        { "url": "https://github.com/BSL-World/bsl-world-public/tree/main/bsl-timer" }
      ]
    }
  ]
}
