{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bsl-timer",
  "version": "0.7.0",
  "identifier": "ru.bsl-world.bsl-timer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BSL-Timer",
        "width": 360,
        "height": 260,
        "center": true,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "preventOverflow": {
          "width": 20,
          "height": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "BSL-World"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzMERGNUYyQzcyNTdDRDUKUldUVmZDWEg4dlVOUXhIMitaQ3MxNGwvOVRRVGR3MWVKOEJ4MnVvRm9rSlY1TlQ4SWYvbzh5R3IK",
      "endpoints": [
        "https://bsl-world.ru/downloads/bsl-timer/latest.json"
      ]
    }
  }
}
